# Copy to .env.local for local dev. In production, set these in the Vercel dashboard.
# NEVER commit real values.

# AI provider selection: 'anthropic' | 'openai'
# This is the DEFAULT — the UI can override per-request via { provider } in the body.
AI_PROVIDER=anthropic

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Metricool
METRICOOL_USER_TOKEN=replace-with-rotated-token-from-metricool-settings-api
METRICOOL_BLOG_ID=4308292
METRICOOL_USER_ID=3377431

# OpusClip (Pro/Business plan)
OPUS_API_KEY=replace-with-key-from-opus-dashboard-lower-left
# Only needed if your OPUS_API_KEY belongs to multiple organizations.
OPUS_ORG_ID=org_...
# Public URL of the webhook receiver so Opus can notify us when clips are ready.
# Point this at your deployment: https://YOUR_DOMAIN/api/opus/webhook
OPUS_WEBHOOK_URL=https://YOUR_DOMAIN/api/opus/webhook
# Secret used to verify webhook signatures. Defaults to OPUS_API_KEY if unset,
# but Opus signs with the sk-... API secret, so set it explicitly to that value.
OPUS_WEBHOOK_SECRET=sk-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Secret shared with the Vercel cron that calls GET /api/metricool/sync
# Use the same value in Vercel env vars; the cron sends it as Authorization: Bearer VALUE
CRON_SECRET=replace-with-a-long-random-string

# Google Drive (permanent storage for Opus clips)
# Persist Opus clips to Drive so the dashboard stops depending on Opus's
# short-lived signed CDN links (which expire in ~3 days and break playback).
# GOOGLE_SERVICE_ACCOUNT_JSON = the full service-account JSON, stringified (one line).
# DRIVE_FOLDER_ID             = target Drive folder id, shared with the service account.
# Set/authorize this credential yourself in Vercel - never commit the JSON.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
DRIVE_FOLDER_ID=replace-with-drive-folder-id


# Semrush (SEO keyword research)
# Powers /api/keywords and the keyword hint injected into every draft in
# /api/generate. WITHOUT this key the integration silently degrades to a
# Semrush link-out only (no real volume/difficulty data reaches the AI).
# Auth: the Semrush Analytics API takes the key as a `key` query parameter.
# Requires a plan/add-on with API access enabled (API units) — verify in your
# Semrush account before setting.
# Set/rotate this value yourself in Vercel; never commit the real key.
SEMRUSH_API_KEY=replace-with-semrush-api-key
# Optional. Semrush Analytics API host; override only if Semrush changes hosts.
SEMRUSH_API_BASE=https://api.semrush.com
# Optional. Semrush regional database for the buyer geography, e.g. 'us' for the
# US market (international patients searching to travel to Cancun). Defaults to us.
SEMRUSH_DATABASE=us
