# Copy to .env.local for local dev. In production, set these in the Vercel dashboard.
# NEVER commit real values.

# AI provider selection: 'anthropic' | 'openai'
# This is the DEFAULT — the UI can override per-request via { provider } in the body.
AI_PROVIDER=anthropic

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
# Unset = claude-sonnet-5, the code default. The writer asks the current models
# (Sonnet 5, Opus 5 / 4.8, Haiku 4.5, Fable 5) for a schema-checked JSON answer,
# which removes the "incomplete or garbled" failure; an older model gets the
# plain request. ANTHROPIC_JSON_OUTPUT=off switches the schema off if ever needed.
#ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- AI image generation (uses OPENAI_API_KEY above) ---
# Every generated content pack (manual + Autopilot) gets one on-brand hero
# image, stored in a public Supabase Storage bucket and stamped on the draft
# as pack._image. All three settings below are OPTIONAL.
# Image model: gpt-image-1 (default). Falls back to OPENAI_IMAGE_FALLBACK_MODEL
# (default gpt-image-1-mini) automatically on API rejections. NOTE: image
# generation requires the OpenAI org behind OPENAI_API_KEY to have API credits.
#
# A NEWER MODEL NEEDS NO DEPLOY. Put its name here and restart: the generator
# tries this model at high quality, then at medium, then without the quality
# parameter at all (its accepted values move between model generations), and
# only then falls back to the model below. So a name that turns out not to
# exist costs one rejected call and still produces an image — which is what
# makes it safe to point this at something new on the day it ships.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_FALLBACK_MODEL=gpt-image-1-mini
# Supabase Storage bucket for generated images (auto-created, public).
IMAGE_BUCKET=content-images
# Supabase Storage bucket for the SMALL videos a post carries (auto-created,
# public, one <fileId>.mp4 per source video).
#
# Only the small ones. This project is on Supabase's FREE plan, whose global
# upload file size limit is FIXED at 50 MB — the field in Storage → Settings is
# greyed out, and raising it means upgrading to Pro. The clinic's reels run
# 96 MB to 1.8 GB, so almost everything goes out through the app's own media
# route instead; see PUBLIC_MEDIA_BASE_URL below. Nothing here has to change.
VIDEO_BUCKET=content-videos
# Optional. Override only if the Supabase plan changes; the default is the Free
# plan's fixed 50 MB. A video larger than this skips the bucket without being
# downloaded first.
#SUPABASE_UPLOAD_MAX_BYTES=52428800

# --- Where Metricool fetches a video from -----------------------------------
#
# Metricool pulls each post's video onto its own storage from a URL this app
# gives it, and both of the obvious places to put that video are closed:
# a Drive download link answers a file over ~100 MB with Google's virus-scan
# web page (which Metricool stored AS the video, with a 200), and Supabase
# refuses the upload outright at 50 MB.
#
# So the app serves the file itself, at
#   https://<base>/api/media/video/<driveId>/<exp>/<sig>/video.mp4
# streaming it out of Drive on demand. Nothing is copied and nothing is stored,
# so there is no size limit to run into.
#
# PUBLIC_MEDIA_BASE_URL is the https origin those links point at, and it is
# deliberately separate from the app's own address, so the host that MOVES THE
# BYTES can be chosen independently of the one running the dashboard.
#
# OPTIONAL. Unset, the app falls back to PUBLIC_BASE_URL, then the origin of
# OPUS_WEBHOOK_URL, then VERCEL_PROJECT_PRODUCTION_URL — so a normal Vercel
# deployment already answers, and System Status names which one it used.
#
# Worth setting it to the Dokploy copy if large videos turn out to be slow or
# to time out: that container is a long-lived Node server with no per-request
# ceiling, where a serverless function has one. Whether a given file actually
# hits that ceiling is a question the deployment answers, not this comment —
# and either way a video Metricool could not fetch means a REFUSED post, never
# a post that goes out with broken media.
#PUBLIC_MEDIA_BASE_URL=https://YOUR_MEDIA_HOST
# Optional. The app's own public https origin, when it differs from the above.
#PUBLIC_BASE_URL=https://YOUR_DOMAIN
#
# Signs those links. Every request to the media route carries an HMAC over the
# file id AND the expiry together, so a link cannot be edited into one for
# another video, nor extended. Rotating this value invalidates every
# outstanding link in one action — the only revocation the scheme has.
# Falls back to ASSISTANT_SESSION_SECRET, then CRON_SECRET. Links last 30 days
# and are re-minted automatically whenever one is read back.
# Generate: openssl rand -hex 32
MEDIA_URL_SECRET=
# Kill switch: set to 'off' to disable image generation without redeploying.
IMAGE_GEN=on
# Every generated image is machine-verified by a vision model. Images must be
# pure CONTENT images: any words/letters/numbers found (textDetected) are a
# hard fail that auto-regenerates with the next composition variant; other
# issues (warped anatomy, logos, off-topic scenes) flag for review. Set to
# 'off' to skip the check.
IMAGE_VERIFY=on
# Vision model used for the verification pass.
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Do posts arrive SCHEDULED, or as drafts to approve? ---------------------
#
# Metricool shows the difference at a glance: a scheduled post is in colour on
# the calendar and publishes itself at its time; a draft is greyed out and waits
# for somebody to press Approve.
#
# DEFAULT: scheduled. A post created by the panel, by the nightly video sweep or
# by the assistant's batch drafter lands ready to go out at its slot, with no
# further press. That is deliberate and it is a real change: nobody sees the
# post between it being created and it publishing.
#
# Set PUBLISH_MODE=review to put the approve-first step back. Everything else
# still applies either way: a post whose copy came from a video does not go out
# without that video, the advertising gate still refuses copy missing its AVISO
# or REF, and a row already published is never sent twice.
#
# Read only from here — never from a request — so a signed-in account cannot ask
# for a live publish.
#PUBLISH_MODE=scheduled

# ---------------------------------------------------------------------------
# AUTOPILOT_AUTOSCHEDULE — may the content engine approve its own work?
# ---------------------------------------------------------------------------
# A different question from PUBLISH_MODE above. That one decides how a post
# ARRIVES in Metricool (scheduled, or greyed out as a draft). This one decides
# whether a person presses Approve on the engine's posts at all.
#
# DEFAULT: off by default. The engine researches, writes, scores and stages
# every occurrence, and then waits. Nothing it writes reaches Metricool until
# somebody reads it and presses the button.
#
# Set AUTOPILOT_AUTOSCHEDULE=on and the engine may send a post ITSELF — but
# only one that clears every bar in lib/autoschedule.ts:
#
#   * its DOI is VERIFIED against Crossref, not merely shaped like a DOI;
#   * the cited study is not one the claim check said fails to support the copy;
#   * it scored at or above the threshold (lib/planner-constants.ts);
#   * the safety review raised no flag at all;
#   * it carries a picture wherever the network refuses a post without one.
#
# Anything short of that waits in the review queue with the reason written on
# its card. That floor fails CLOSED — an unreachable Crossref reads as "not
# known", never as "fine" — because the cost of waiting is a button and the
# cost of guessing is a published medical advertisement.
#
# Turning it back off is the same one edit, and takes effect on the next tick.
#AUTOPILOT_AUTOSCHEDULE=on

# ---------------------------------------------------------------------------
# WordPress — where the weekly article is published
# ---------------------------------------------------------------------------
# The blog slot writes a 600-900 word article and publishes it here, while the
# same pack's short promo posts go to Instagram, Facebook and LinkedIn through
# Metricool. No plugin: this is the REST API WordPress has shipped since 4.7.
#
# WITH NONE OF THESE SET, THE BLOG PATH IS SIMPLY OFF. A template that asks for
# an article says so and stays in the queue, rather than failing silently.
#
# WORDPRESS_APP_PASSWORD IS NOT YOUR LOGIN PASSWORD. Generate one under
# Users → Profile → Application Passwords: it is issued per application and can
# be revoked on its own, which is the whole reason to use one. Paste it exactly
# as WordPress prints it — the spaces are ignored.
#
# WORDPRESS_BASE_URL is the SITE root, not the API root: https://example.com,
# not https://example.com/wp-json. (A pasted API root is corrected rather than
# turned into a 404, but the site root is what is meant.)
#
# WORDPRESS_STATUS decides how an article arrives. Default `future`: dated to
# its slot and published by WordPress at that hour, the way posts land on the
# Metricool calendar. `draft` puts it in WordPress for somebody to press
# Publish. `publish` makes it live the moment the post is approved. An
# unreadable value falls back to `future` rather than to `publish`.
#
# WORDPRESS_CATEGORY is a category ID (a number), if articles are filed under
# one. Anything that is not a number is ignored.
#WORDPRESS_BASE_URL=https://your-clinic-site.com
#WORDPRESS_USER=the-wordpress-username
#WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
#WORDPRESS_STATUS=future
#WORDPRESS_CATEGORY=

# Metricool
METRICOOL_USER_TOKEN=replace-with-rotated-token-from-metricool-settings-api
METRICOOL_BLOG_ID=4308292
METRICOOL_USER_ID=3377431

# OpusClip (Pro/Business plan)
OPUS_API_KEY=replace-with-key-from-opus-dashboard-lower-left
# Only needed if your OPUS_API_KEY belongs to multiple organizations.
OPUS_ORG_ID=org_...
# Public URL of the webhook receiver so Opus can notify us when clips are ready.
# Point this at your deployment: https://YOUR_DOMAIN/api/opus/webhook
OPUS_WEBHOOK_URL=https://YOUR_DOMAIN/api/opus/webhook
# Secret used to verify webhook signatures. Defaults to OPUS_API_KEY if unset,
# but Opus signs with the sk-... API secret, so set it explicitly to that value.
OPUS_WEBHOOK_SECRET=sk-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Secret shared with the Vercel cron that calls GET /api/metricool/sync and
# GET /api/autopilot/tick. Use the same value in Vercel env vars; the cron sends
# it as Authorization: Bearer VALUE.
#
# REQUIRED. Without it BOTH crons fail closed every day: /api/metricool/sync
# returns 401 at its bearer check, and /api/autopilot/tick falls through to
# session auth that a cron does not have. Autopilot never plans or advances a
# run and post_metrics is never populated, so the learning loop has no data to
# learn from - and nothing anywhere reports that this is happening.
# Generate: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# Signs the assistant's session object, which round-trips through the browser.
# Optional but recommended: without it the app falls back to CRON_SECRET and
# then to SUPABASE_SERVICE_ROLE_KEY. Borrowing the service-role key works, but
# couples the most privileged credential in the system to an unrelated purpose -
# rotating one then forces the other.
# Generate: openssl rand -hex 32
ASSISTANT_SESSION_SECRET=

# Google Drive
#
# Two jobs: permanent storage for Opus clips (whose signed CDN links expire in
# ~3 days), and — the one that matters more — the world-readable COPY of each
# video. Metricool cannot fetch a private Drive file, so a post's video is a
# copy of it living in this folder. No folder, no video on any post.
#
# GOOGLE_SERVICE_ACCOUNT_JSON = the full service-account JSON, stringified (one line).
# DRIVE_FOLDER_ID             = a folder INSIDE A SHARED DRIVE. See below.
#
# !! THE FOLDER MUST BE IN A SHARED DRIVE !!
#
# A Google service account owns ZERO bytes of Drive storage. A file it creates
# in an ordinary My Drive folder is charged against that 0-byte quota and
# refused with storageQuotaExceeded — every file, every time, however much space
# the folder's human owner has. This is not a quota you can top up; it is the
# absence of one. In a Shared Drive the drive owns the file and the
# organisation is billed, so the limit never applies.
#
# Setup:
#   1. Google Drive -> Shared drives -> New
#   2. Manage members -> add the service account's `client_email` (it ends in
#      .iam.gserviceaccount.com) as CONTENT MANAGER
#   3. Create a folder inside it; DRIVE_FOLDER_ID is the id in the URL after
#      /folders/
#   4. Deploy, then open System Status and press "Test the Drive setup". It
#      creates a file, shares it, fetches it back with no credentials (exactly
#      what Metricool does) and deletes it. All four steps must be green.
#
# If the Shared Drive belongs to a different Workspace account, that is fine —
# but two admin settings there decide it, under Admin console -> Apps ->
# Google Workspace -> Drive and Docs -> Sharing settings: external members must
# be allowed on shared drives (or step 2 fails), and link-sharing outside the
# organisation must be allowed (or the share step of the test fails).
#
# Set/authorize this credential yourself in Vercel - never commit the JSON.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
DRIVE_FOLDER_ID=replace-with-a-folder-id-inside-a-shared-drive


# Semrush (SEO keyword research)
# Powers /api/keywords and the keyword hint injected into every draft in
# /api/generate. WITHOUT this key the integration silently degrades to a
# Semrush link-out only (no real volume/difficulty data reaches the AI).
# Auth: the Semrush Analytics API takes the key as a `key` query parameter.
# Requires a plan/add-on with API access enabled (API units) — verify in your
# Semrush account before setting.
# Set/rotate this value yourself in Vercel; never commit the real key.
SEMRUSH_API_KEY=replace-with-semrush-api-key
# Optional. Semrush Analytics API host; override only if Semrush changes hosts.
SEMRUSH_API_BASE=https://api.semrush.com
# Optional. Semrush regional database for the buyer geography, e.g. 'us' for the
# US market (international patients searching to travel to Cancun). Defaults to us.
SEMRUSH_DATABASE=us
# Optional. Unit-spend guard: when the Standard API unit balance would drop
# below this floor, the app stops making live Semrush calls and serves
# cache/link-out only. Protects a fixed unit pot from silent draining.
SEMRUSH_UNIT_FLOOR=5000
# Optional. Days a cached Semrush lookup stays fresh (volumes update ~monthly).
# Repeat topics inside the window cost 0 API units.
SEMRUSH_CACHE_TTL_DAYS=30
# The domain the Semrush Intelligence panel analyzes by default.
SEMRUSH_DOMAIN=cellularhopeinstitute.com
# Optional. Hours a cached DOMAIN report (overview/backlinks/rankings/
# competitors) stays fresh. Domain metrics move slowly; 24h keeps the panel
# current at ~1 refresh per day of unit spend.
SEMRUSH_DOMAIN_CACHE_TTL_HOURS=24
# Optional. Your Semrush PROJECT id (the number in the project URL at
# https://www.semrush.com/projects/). Unlocks the Site Health tab: Site Audit
# score/errors/warnings + Position Tracking visibility. Requires a Semrush
# plan with Projects API access; without it the tab shows a link-out.
SEMRUSH_PROJECT_ID=

# --- Autopilot Content Engine ---
# The daily cron tick (/api/autopilot/tick) is authorized by the SAME
# CRON_SECRET declared above — do NOT redeclare it here (a second empty
# declaration would win last-parse and silently break both crons).

# --- Nightly maintenance (/api/maintenance/prune) ---
# Authorized by the SAME CRON_SECRET declared above — do NOT redeclare it here.
#
# Removes what nothing can read any more: rate-limit events older than a day,
# Semrush spend rows older than last month, and images in the public bucket
# that no draft references and that are over a week old. Until this is "on"
# every run is a DRY RUN that only reports what it would remove — read one
# night's report in the Vercel cron logs, then switch it on.
MAINTENANCE_PRUNE=

# --- Video Autopilot ---
# A new link in the video sheet becomes a transcript, a keyword brief, a REF
# citation and publish-ready copy on its own. See docs/video-autopilot.md.
#
# Authorized by the SAME CRON_SECRET declared above — do NOT redeclare it here.
#
# Whose brand voice the sweep writes in, and who owns the drafts it saves.
# Optional: without it the workspace's oldest brand profile is used. Set it if
# more than one account has a Brand Brain saved.
VIDEO_AUTOPILOT_USER_ID=
# Optional. Speech-to-text model for Drive-hosted videos, which have no
# captions. Defaults to whisper-1 (which also reports the language it heard).
# Uses OPENAI_API_KEY above; without that key the sweep asks for a pasted
# transcript instead of guessing.
#
# Optional. ffmpeg-static's own override, checked before it computes a path
# from __dirname. Point it at a binary already on the image if the build cannot
# fetch one. (lib/audio-extract.ts also honours FFMPEG_PATH.)
FFMPEG_BIN=
# The deployed functions do NOT carry the ffmpeg binary (77 MB in every
# function filled Vercel's Function Storage). It is fetched once per warm
# instance from the ffmpeg-static release asset, pinned by SHA-256, and cached
# in /tmp. Both optional: set them only to serve a copy you host yourselves.
# A URL without a hash keeps the pinned hash, so a mirror must be the same file.
FFMPEG_DOWNLOAD_URL=
FFMPEG_SHA256=
# The video itself is never uploaded to the transcriber. The clinic's reels run
# 76-283 MB and the endpoint refuses anything over 25 MB, so ffmpeg lifts out
# the audio track first (16 kHz mono, a couple of MB) and only that is sent.
# Nothing to configure - the binary ships with the app via ffmpeg-static.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Auth allowlist ---
# Comma-separated emails allowed to sign in. Enforced server-side in the
# middleware and in the auth callback (both via lib/access.ts); the NEXT_PUBLIC_
# copy only powers the client-side hint on the sign-in page and is trivially
# bypassed, so never rely on it alone.
#
# Set ALLOWED_EMAILS explicitly. If it is unset the allowlist resolves to a
# hardcoded default in lib/access.ts, which means changing who can sign in
# requires a code change and a deploy.
#
# Also confirm "Allow new users to sign up" is OFF in the Supabase dashboard:
# the anon key ships in the browser bundle, so the signup endpoint is reachable
# by anyone unless that toggle is off. An account created that way is not on the
# allowlist and every route will refuse it - but not creating it is better.
ALLOWED_EMAILS=you@example.com
NEXT_PUBLIC_ALLOWED_EMAILS=you@example.com

# TikTok drafts are sent public with comments, duet and stitch on. Set to 'on' to
# add TikTok's own-brand commercial-content disclosure to every post.
#TIKTOK_COMMERCIAL_OWN_BRAND=off
# Optional. IANA timezone used when scheduling Metricool posts (default America/Cancun).
# This is also the zone every scheduled time is DISPLAYED in: the root layout
# stamps the resolved value on <html data-schedule-tz> and lib/schedule-clock.ts
# reads it back, so the composer, the queue and the calendar cannot disagree.
METRICOOL_TIMEZONE=America/Cancun
# Optional. IANA timezone for template/Autopilot wall-clock times ("post at
# 09:00"). Defaults to METRICOOL_TIMEZONE, then America/Cancun. All schedule
# planning converts through this zone — never the server's UTC clock.
SCHEDULE_TIMEZONE=America/Cancun

# Optional. Rate limiting fails CLOSED on database errors by default (safe).
# Set to 'true' only if you prefer availability over protection during outages.
RATE_LIMIT_FAIL_OPEN=

# ---------------------------------------------------------------------------
# The Google Sheets and Drive folder the Sources section reads.
#
# Undocumented until now, which mattered: without SOURCES_VIDEOS_SHEET_ID there
# is no video pipeline at all — the sweep has nothing to read and the Video
# Library is empty, with nothing anywhere saying why.
SOURCES_VIDEOS_SHEET_ID=replace-with-the-video-sheet-id
SOURCES_CALENDAR_SHEET_ID=replace-with-the-calendar-sheet-id
SOURCES_IMAGES_FOLDER_ID=replace-with-the-images-folder-id

# What time of day the sweep schedules posts for, on the clinic's clock.
# Defaults to 08:00 when unset.
#
# COMMENTED OUT ON PURPOSE. Setting this pins ONE slot a day and overrides the
# two-a-day default (08:00 and 17:00) entirely — a deployment that copied this
# file with the line active was silently running a single 09:00 slot. Use
# VIDEO_AUTOPILOT_TIMES below if you want to change the grid.
#VIDEO_AUTOPILOT_TIME=08:00

# --- Two videos a day, from a given row -------------------------------------
# The settings behind "two a day, in sheet order, from row 179 onward". The
# first three carry the clinic's answer as their DEFAULT in code, so nothing
# has to be set for the sweep to start at 179 and book two slots a day; set
# them only to change that.
#
# VIDEO_AUTOPILOT_TIMES  comma list of slot times on the clinic's clock, one
#                        post per slot. Default 08:00,17:00. Overrides the
#                        older VIDEO_AUTOPILOT_TIME when set.
# VIDEO_POST_DAYS        default every day; `weekdays` for Monday–Friday.
# VIDEO_START_ROW        the first sheet row the sweep may prepare. Default
#                        179 on every tab; `Marzo!179` limits it to one tab;
#                        `none` switches the rule off. Rows above it stay in
#                        the library and the register but are never prepared
#                        by the sweep.
# VIDEO_DAILY_QUOTA      rows prepared per day, counted on the clinic's clock
#                        across every run and every Prepare button. The sweep
#                        stops for the day once the count is reached. No
#                        default: unset, the sweep clears the backlog as fast
#                        as its runs allow (every 15 minutes, up to 5 a run).
#VIDEO_AUTOPILOT_TIMES=08:00,17:00
#VIDEO_POST_DAYS=all
#VIDEO_START_ROW=179
#VIDEO_DAILY_QUOTA=2
# VIDEO_QUEUE_EXISTING_COPY  on by default: a row at or after the start row
#                        whose COPY cell is already written is sent to
#                        Metricool as a draft with its video, the copy
#                        unchanged (never written back). `off` limits the
#                        sweep to rows with an empty COPY cell, as before.
#VIDEO_QUEUE_EXISTING_COPY=on

# Visibility a YouTube draft gets when a person presses Approve. One of
# public | unlisted | private; defaults to public, because a marketing video
# that publishes to nobody makes Approve a no-op. The sheet's YOUTUBE column
# overrides this per row when it says "Unlisted".
YOUTUBE_DEFAULT_PRIVACY=public

# The COFEPRIS advertising permit number that must appear on every post.
# Brand Brain's value wins over this one; this is the deployment-wide fallback.
AVISO_PUBLICIDAD=replace-with-the-clinic-permit-number
